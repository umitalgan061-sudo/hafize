{
  "extends": "./tsconfig.json",
  "include": [
    "public/**/*.ts"
  ],
  "exclude": [
    "public/**/*.test.ts",
    "public/typed-build/**"
  ],
  "compilerOptions": {
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "types": [
      "vite/client"
    ]
  }
}
