{
  "$schema": "https://json.schemastore.org/tsconfig",
  "// Neden": [
    "Hafize derleme adımı olmayan bir projedir. Node 22.18+ .ts dosyalarını",
    "yerel olarak tip-sıyırma ile çalıştırdığı için bundler, dist/ veya",
    "transpile adımı yoktur. TypeScript burada yalnızca tip denetleyicisidir:",
    "her zaman noEmit, asla runtime bağımlılığı.",
    "erasableSyntaxOnly, Node'un çalıştıramayacağı enum/namespace/parametre",
    "özelliği gibi sözdizimini derleme zamanında reddeder."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "allowJs": true,
    "checkJs": true,

    "strict": false,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
