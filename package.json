{
  "name": "hafize-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Hafize kişisel yapay zekâ çalışma alanı — güvenli, Claude-benzeri frontend başlangıcı.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --import ./lib/production-guard.mjs server.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --import ./lib/production-guard.mjs server.mjs",
    "build": "node scripts/run-typecheck.mjs && vite build",
    "typecheck": "node scripts/run-typecheck.mjs",
    "format:check": "node scripts/format-check.mjs",
    "precheck": "node scripts/run-checks.mjs --filter=voice-input,voice-output,ui-shell,sidebar-accessibility",
    "check": "node scripts/run-checks.mjs",
    "test": "node scripts/run-checks.mjs"
  },
  "dependencies": {
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.0"
  }
}
