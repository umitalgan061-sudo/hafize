{
  "name": "hafize-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Hafize kişisel yapay zekâ çalışma alanı — güvenli, Claude-benzeri frontend başlangıcı.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --import ./lib/production-guard.mjs server.mjs",
    "precheck": "node scripts/run-checks.mjs --filter=voice-input,voice-output,ui-shell,sidebar-accessibility && npm run typecheck",
    "check": "node scripts/run-checks.mjs && npm run typecheck",
    "test": "npm run check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
