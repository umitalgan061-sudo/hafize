NODE_ENV=production
HOST=0.0.0.0
PORT=4173
HAFIZE_AUTH_REQUIRED=true
HAFIZE_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters
HAFIZE_AUTH_SUBJECT=primary-user
HAFIZE_COOKIE_SECURE=true
HAFIZE_AUTH_SESSION_TTL_SECONDS=604800
HAFIZE_TRUST_PROXY=false
HAFIZE_CONNECTOR_AUTH_TOKEN=
HAFIZE_CONNECTOR_AUTH_SUBJECT=connector-client
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional local Ollama provider; model traffic stays on this device.
HAFIZE_LOCAL_MODEL_ENABLED=false
HAFIZE_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
GITHUB_TOKEN=
HAFIZE_GITHUB_READ_REPOS=
HAFIZE_GITHUB_WRITE_REPOS=
HAFIZE_SCHEDULE_AUTH_TOKEN=
HAFIZE_SCHEDULE_AUTH_SUBJECT=
HAFIZE_METRICS_TOKEN=
HAFIZE_REQUEST_TIMEOUT_MS=180000
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Agent platform (all optional; sensible defaults) ---
# Long agent runs (research, multi-step tasks, approval waits).
HAFIZE_AGENT_TIMEOUT_MS=900000
# Memory and data encryption. Empty: a key is generated in data/master.key on first start.
# Keep a copy of that key; without it the encrypted memory cannot be read.
HAFIZE_MASTER_KEY=
# HAFIZE_DATA_DIR=data
# Folder the local tools (files, SQLite, shell) are confined to.
# HAFIZE_WORKSPACE_DIR=workspace
# Models used internally (defaults shown).
# HAFIZE_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# HAFIZE_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# HAFIZE_VISION_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,meta/llama-3.2-11b-vision-instruct
# HAFIZE_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# HAFIZE_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# Offline fallback through Ollama (set HAFIZE_LOCAL_MODEL_ENABLED=true above).
HAFIZE_LOCAL_CHAT_MODEL=
HAFIZE_LOCAL_EMBED_MODEL=
# Encrypted backups: a folder (OneDrive/Google Drive/iCloud sync folder, NAS) or WebDAV.
# Zamanlanmış görev ve kuralların modeli; boşsa NVIDIA varsayılan modeli kullanılır.
# Telefona kurulum için yerel ağda HTTPS portu (ör. 4443); boşsa kapalı. HAFIZE_AUTH_REQUIRED=true ister.
HAFIZE_HTTPS_PORT=
HAFIZE_SCHEDULE_MODEL=
HAFIZE_BACKUP_DIR=
HAFIZE_BACKUP_WEBDAV_URL=
HAFIZE_BACKUP_WEBDAV_USER=
HAFIZE_BACKUP_WEBDAV_PASSWORD=
HAFIZE_BACKUP_PASSPHRASE=
HAFIZE_BACKUP_INTERVAL_HOURS=24
# Signed skill bundle update feed (https JSON: {"bundles":[{"url":"https://..."}]}).
HAFIZE_SKILL_FEED_URL=
# OpenTelemetry export of spans (OTLP/HTTP JSON), e.g. http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Cost estimate shown in the dashboard (per million tokens).
HAFIZE_TOKEN_COST_PER_MTOK=0
