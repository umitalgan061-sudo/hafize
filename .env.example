# Hafize ortam değişkenleri — örnek dosya.
#
# Bu dosyayı `.env` olarak KOPYALAMA ve gerçek anahtarları buraya YAZMA.
# Bu dosya repoda tutulur; `.env` ve gerçek anahtarlar asla commit edilmez.
# Değerleri kendi makinende kabuk ortamına ya da barındırma platformunun
# secret manager'ına gir.
#
# Gruplar "hep birlikte" çalışır: bir grubun bazı değişkenlerini tanımlayıp
# gerisini boş bırakırsan Hafize ya o özelliği sessizce kapatır ya da (grup
# işaretliyse) açılışta durur. Sunucu her başlangıçta hangi grubun eksik
# olduğunu yazar.

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4173

# ---------------------------------------------------------------------------
# 1) NVIDIA NIM sohbeti — ZORUNLU
# Bu olmadan sohbet, model listesi ve zamanlanmış görev yürütme çalışmaz.
# Anahtarı https://build.nvidia.com adresinden alırsın.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
# Opsiyonel: varsayılan https://integrate.api.nvidia.com/v1
NIM_BASE_URL=
# Opsiyonel: context sıkıştırma eşiği (16000-2000000, varsayılan 128000)
HAFIZE_CONTEXT_LIMIT_TOKENS=

# ---------------------------------------------------------------------------
# 2) Gmail / Canva connector kimliği — hepsi ya da hiçbiri
# Kısmi bırakılırsa sunucu AÇILIŞTA DURUR.
# Anahtar üretimi:
#   HAFIZE_CONNECTOR_AUTH_TOKEN : openssl rand -hex 32
#   *_KEY_B64                   : openssl rand -base64 32
# ---------------------------------------------------------------------------
HAFIZE_CONNECTOR_AUTH_TOKEN=
HAFIZE_CONNECTOR_AUTH_SUBJECT=
HAFIZE_CONNECTOR_OWNER_KEY_B64=
HAFIZE_OAUTH_TOKEN_STORAGE_DIR=
HAFIZE_OAUTH_TOKEN_KEY_B64=

# ---------------------------------------------------------------------------
# 3) GitHub salt-okunur erişim — hepsi ya da hiçbiri
# İkisi birden tanımlı değilse github_read_file aracı ajanlara sunulmaz.
# Token'a yalnızca dar, salt-okunur kapsam ver.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
# Virgülle ayrılmış izin listesi, örn: umitalgan061-sudo/hafize
HAFIZE_GITHUB_READ_REPOS=

# ---------------------------------------------------------------------------
# 4) Zamanlanmış görev API'si — hepsi ya da hiçbiri
# Kısmi bırakılırsa sunucu AÇILIŞTA DURUR.
# ---------------------------------------------------------------------------
HAFIZE_SCHEDULE_AUTH_TOKEN=
HAFIZE_SCHEDULE_AUTH_SUBJECT=
# Opsiyonel
HAFIZE_SCHEDULE_MODEL=
HAFIZE_SCHEDULE_TICK_MS=
HAFIZE_SCHEDULE_RUN_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 5) Zamanlanmış görev kalıcı deposu — hepsi ya da hiçbiri
# Kısmi bırakılırsa sunucu AÇILIŞTA DURUR.
# Tanımlanmazsa görevler yalnızca bellekte tutulur ve yeniden başlatmada silinir.
# ---------------------------------------------------------------------------
HAFIZE_SCHEDULE_STORAGE_FILE=
HAFIZE_SCHEDULE_STORAGE_KEY_BASE64=

# ---------------------------------------------------------------------------
# 6) Çok örnekli çalıştırma kilidi (Redis) — hepsi ya da hiçbiri
# Yalnızca birden fazla sunucu örneği çalıştıracaksan gerekir.
# ---------------------------------------------------------------------------
HAFIZE_SCHEDULE_LEASE_PROVIDER=
HAFIZE_SCHEDULE_REDIS_URL=
# Opsiyonel
HAFIZE_SCHEDULE_LEASE_HOLDER_ID=
HAFIZE_SCHEDULE_LEASE_MS=
HAFIZE_SCHEDULE_LEASE_RENEW_INTERVAL_MS=

# ---------------------------------------------------------------------------
# 7) Şifreli kişisel bellek — hepsi ya da hiçbiri
# Kısmi bırakılırsa sunucu AÇILIŞTA DURUR.
# ---------------------------------------------------------------------------
HAFIZE_MEMORY_STORAGE_DIR=
HAFIZE_MEMORY_KEY_B64=
# Opsiyonel
HAFIZE_MEMORY_MAX_FILE_BYTES=

# ---------------------------------------------------------------------------
# 8) Yerel model sağlayıcısı — opsiyonel
# ---------------------------------------------------------------------------
HAFIZE_LOCAL_MODEL_ENABLED=
HAFIZE_LOCAL_MODEL_BASE_URL=
