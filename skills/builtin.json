        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "question",
        "findings",
        "sources"
      ]
    },
    "sideEffects": {
      "idempotent": true,
      "mutates": false,
      "external": false
